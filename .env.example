# Copy to .env and fill in. Never commit .env.

# Required: your OpenRouter key (https://openrouter.ai/keys). Jev usage is billed to it.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jev model. typesafe/jev-latest tracks the newest release; pin a version
# (e.g. typesafe/jev-1.14) for reproducible production behaviour.
JEV_MODEL=typesafe/jev-latest

# Vision-capable model for box questions / image state (templates/04_box_locate.py).
# Check https://openrouter.ai/typesafe for which Jev variants accept images.
JEV_VISION_MODEL=typesafe/jev-latest

# Which OpenRouter endpoint to call: "systemone" (/api/v1/systemone, TypeSafe-SDK compatible)
# or "decisions" (/api/alpha/decisions).
JEV_ENDPOINT=systemone

# Base URL; change only for a proxy/gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Model used for the Jev Router chat template (templates/06_jev_router_chat.py).
JEV_ROUTER_MODEL=typesafe/jev-router

# Optional attribution shown on your OpenRouter dashboard.
OPENROUTER_APP_URL=https://github.com/your-name/your-app
OPENROUTER_APP_TITLE=Jev System One Templates

# Set to 1 to print request payloads instead of sending them (no key or network needed).
JEV_DRY_RUN=0

# For the official TypeSafe SDK template only: point the SDK at OpenRouter.
TYPESAFE_API_KEY=${OPENROUTER_API_KEY}
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_DEFAULT_MODEL=typesafe/jev-latest
